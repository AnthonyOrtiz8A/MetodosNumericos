@model List<Calculadora_de_Ecuaciones.Models.GaussSeidelModel>

<h2 class="text-center mt-3">Historial de Cálculos - Método de Gauss-Seidel</h2>

<div class="container mt-4">
    <a href="@Url.Action("Index", "GaussSeidel")" class="btn btn-primary mb-3">Volver al cálculo</a>

    @if (Model != null && Model.Any())
    {
        foreach (var grupo in Model)
        {
            <div class="card mb-4 shadow-sm p-3">
                <h4>Sistema de ecuaciones - <strong>@grupo.Dimension x @grupo.Dimension</strong></h4>
                <p><strong>Máx. Iteraciones:</strong> @grupo.MaxIteraciones</p>
                <p><strong>Tolerancia:</strong> @grupo.Tolerancia.ToString("0.############################")</p>
                <p><strong>Fecha:</strong> @grupo.Fecha.ToString("yyyy-MM-dd HH:mm:ss")</p>

                @if (grupo.Solucion != null && grupo.Solucion.Length > 0)
                {
                    <p>
                        <strong>Solución final:</strong>
                        @for (int i = 0; i < grupo.Solucion.Length; i++)
                        {
                            <span>X@i = @grupo.Solucion[i].ToString("F6")</span>
                            @(i < grupo.Solucion.Length - 1 ? ", " : "")
                        }
                    </p>
                }

                @if (grupo.Iteraciones != null && grupo.Iteraciones.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover mt-3">
                            <thead class="table-dark">
                                <tr>
                                    <th>Iteración</th>
                                    @for (int i = 0; i < grupo.Iteraciones.First().Valores.Length; i++)
                                    {
                                        <th>X@i</th>
                                    }
                                    <th>Error</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var resultado in grupo.Iteraciones)
                                {
                                    <tr>
                                        <td>@resultado.Iteracion</td>
                                        @foreach (var x in resultado.Valores)
                                        {
                                            <td>@x.ToString("F6")</td>
                                        }
                                        <td>@resultado.Error.ToString("F9")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="text-center mt-3">
                    <a href="@Url.Action("GenerarPDF", "GaussSeidel", new { grupoId = grupo.GrupoId })"
                       class="btn btn-success btn-sm">
                        Descargar PDF
                    </a>
                    <a href="@Url.Action("BorrarGrupo", "GaussSeidel", new { grupoId = grupo.GrupoId })"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('¿Estás seguro de que deseas eliminar este grupo?');">
                        Eliminar
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center">No hay cálculos guardados.</div>
    }
</div>

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #ffe0b2;
    }
    .logo-container img {
        width: 100px;
        margin-top: 10px;
    }
</style>
