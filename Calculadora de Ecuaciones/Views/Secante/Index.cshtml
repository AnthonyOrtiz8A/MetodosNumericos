@model Calculadora_de_Ecuaciones.Models.SecanteModel

@{
    ViewBag.Title = "Método de la Secante";
}

<h2 class="text-center mt-4 mb-4">Método de la Secante</h2>

<div class="container">
    <div class="card shadow-lg border-0 rounded-4 p-5 bg-light">

        @using (Html.BeginForm("Index", "Secante", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
        {
            <div class="mb-4">
                <label class="form-label fw-semibold">Función f(x):</label>
                @Html.TextBoxFor(m => m.Funcion, new { @class = "form-control form-control-lg", @placeholder = "Ej: x^3 - x - 2" })
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">x₀:</label>
                    @Html.TextBoxFor(m => m.X0, new { @class = "form-control form-control-lg", type = "number", step = "any" })
                </div>
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">x₁:</label>
                    @Html.TextBoxFor(m => m.X1, new { @class = "form-control form-control-lg", type = "number", step = "any" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">Número máximo de iteraciones:</label>
                    @Html.TextBoxFor(m => m.MaxIter, new { @class = "form-control form-control-lg", type = "number", value = "100", required = "required" })
                </div>
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">Tolerancia:</label>
                    @Html.TextBoxFor(m => m.Tolerancia, new { @class = "form-control form-control-lg", type = "text", placeholder = "Ej: 0.000000000123456789", required = "required", inputmode = "decimal" })
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-outline-primary btn-lg">Calcular</button>
                <a href="@Url.Action("Historial", "Secante")" class="btn btn-outline-secondary btn-lg">Ver historial</a>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            var tipoMensaje = Model.TipoMensaje == "error" ? "alert-danger" : "alert-warning";
            <div class="alert @tipoMensaje mt-4 text-center rounded-3">
                <strong>@Model.Mensaje</strong>
            </div>
        }

        @if (Model.Resultados != null && Model.Resultados.Any())
        {
            <h3 class="mt-5 text-center">Resultados:</h3>
            <div class="table-responsive mt-3">
                <table class="table table-striped table-hover table-bordered">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Iteración</th>
                            <th>x₀</th>
                            <th>x₁</th>
                            <th>x₂</th>
                            <th>Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Resultados)
                        {
                            <tr class="text-center">
                                <td>@r.Iteracion</td>
                                <td>@r.Xi.ToString("F6")</td>
                                <td>@r.Xi_1.ToString("F6")</td>
                                <td>@r.XiMas1.ToString("F6")</td>
                                <td>@r.Error.ToString("F9")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            var ultimaIteracion = Model.Resultados.Last();
            <div class="alert alert-success text-center mt-4 rounded-3">
                <p><strong>Raíz aproximada:</strong> @ultimaIteracion.XiMas1.ToString("F6")</p>
                <p><strong>Total de iteraciones:</strong> @Model.Resultados.Count</p>
            </div>

        }
    </div>
</div>

<style>
    .logo-container img {
        width: 100px;
        margin-top: 10px;
    }
</style>