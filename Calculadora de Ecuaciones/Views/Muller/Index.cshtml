@model Calculadora_de_Ecuaciones.Models.MullerModel

<h2 class="text-center mt-4 mb-4">Método de Müller</h2>

<div class="container">
    <div class="card shadow-lg border-0 rounded-4 p-5 bg-light">
        <p class="text-muted text-center mb-4">
            Puedes usar funciones como: <code>e^x</code>, <code>ln(x)</code>, <code>sqrt(x)</code>, <code>sin(x)</code>, <code>cos(x)</code>, <code>x^2</code>, etc.
        </p>

        @using (Html.BeginForm("Calculate", "Muller", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
        {
            <div class="mb-4">
                <label class="form-label fw-semibold">Función f(x):</label>
                @Html.TextBoxFor(m => m.Funcion, new { @class = "form-control form-control-lg", @placeholder = "Ej: x^3 - x - 2" })
            </div>

            <div class="row">
                <div class="col-md-4 mb-4">
                    <label class="form-label fw-semibold">x₀:</label>
                    @Html.TextBoxFor(m => m.X0, new { @class = "form-control form-control-lg", type = "number", step = "any" })

                    <label class="form-label fw-semibold mt-4">Máximo de iteraciones:</label>
                    @Html.TextBoxFor(m => m.MaxIter, new { @class = "form-control form-control-lg", type = "number", value = "100", required = "required" })
                </div>
                <div class="col-md-4 mb-4">
                    <label class="form-label fw-semibold">x₁:</label>
                    @Html.TextBoxFor(m => m.X1, new { @class = "form-control form-control-lg", type = "number", step = "any" })

                    <label class="form-label fw-semibold mt-4">Tolerancia:</label>
                    @Html.TextBoxFor(m => m.Tolerancia, new { @class = "form-control form-control-lg", type = "text", placeholder = "Ej: 0.000000000123456789", required = "required", inputmode = "decimal" })
                </div>
                <div class="col-md-4 mb-4">
                    <label class="form-label fw-semibold">x₂:</label>
                    @Html.TextBoxFor(m => m.X2, new { @class = "form-control form-control-lg", type = "number", step = "any" })
                </div>
            </div>



            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-outline-primary btn-lg">Calcular</button>
                <a href="@Url.Action("Historial", "Muller")" class="btn btn-outline-secondary btn-lg">Ver historial</a>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="alert @(Model.TipoMensaje == "error" ? "alert-danger" : "alert-warning") mt-4 text-center rounded-3">
                <strong>@Model.Mensaje</strong>
            </div>
        }

        @if (Model.Iteraciones != null && Model.Iteraciones.Count > 0)
        {
            <h3 class="mt-5 text-center">Detalles de cada iteración</h3>
            <div class="table-responsive mt-3">
                <table class="table table-striped table-hover table-bordered">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Iteración</th>
                            <th>x₀</th>
                            <th>x₁</th>
                            <th>x₂</th>
                            <th>A</th>
                            <th>B</th>
                            <th>C</th>
                            <th>Siguiente x</th>
                            <th>Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Iteraciones)
                        {
                            <tr class="text-center">
                                <td>@item.Iteracion</td>
                                <td>@item.X0.ToString("F6")</td>
                                <td>@item.X1.ToString("F6")</td>
                                <td>@item.X2.ToString("F6")</td>
                                <td>@item.A.ToString("F6")</td>
                                <td>@item.B.ToString("F6")</td>
                                <td>@item.C.ToString("F6")</td>
                                <td>@item.NextX.ToString("F6")</td>
                                <td>@item.MargenError.ToString("F9")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="alert alert-success text-center mt-4 rounded-3">
                <p><strong>Raíz aproximada:</strong> @Model.Iteraciones.Last().NextX.ToString("F6")</p>
                <p><strong>Total de iteraciones:</strong> @Model.Iteraciones.Count</p>
            </div>

        }
    </div>
</div>

<style>
    .logo-container img {
        width: 100px;
        margin-top: 10px;
    }
</style>
