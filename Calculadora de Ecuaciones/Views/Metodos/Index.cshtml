@{
    ViewBag.Title = "Métodos Numéricos 2025 - Grupo #2";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(to right, #e0f7fa, #ffffff);
            color: #333;
        }

        .content {
            text-align: center;
            padding: 60px 20px;
        }

            .content h1 {
                font-size: 2.8em;
                color: #007BFF;
                margin-bottom: 10px;
            }

            .content h2 {
                font-size: 1.8em;
                color: #555;
            }

        .footer {
            background-color: #f1f1f1;
            padding: 30px 20px;
            text-align: center;
            font-size: 14px;
            color: #666;
            border-top: 1px solid #ddd;
        }

        .logo-container img {
            width: 100px;
            margin-top: 15px;
            transition: transform 0.3s;
        }

            .logo-container img:hover {
                transform: scale(1.1);
            }
    </style>
</head>
<body>

    <!-- Contenido principal -->
    <div class="content">
        <h1>Proyecto de Métodos Numéricos</h1>
        <h2>Grupo #2 - Semestre 1-2025</h2>
    </div>

    <!-- Pie de página -->
    <div class="footer">
        <p>Facultad de Ingeniería en Sistemas</p>
        <p>Centro Universitario de Chiquimulilla, Santa Rosa</p>
        <p>Semestre 1-2025</p>
        <div style="margin-right: 30px;">
            <img src="~/Content/Fotos/Umg.png" alt="Logo UMG" style="height: 100px;"   />
        </div>
    </div>

</body>
</html>
