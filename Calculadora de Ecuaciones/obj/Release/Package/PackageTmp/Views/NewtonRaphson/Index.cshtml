@model Calculadora_de_Ecuaciones.Models.NewtonRaphsonModel

@{
    ViewBag.Title = "Método de Newton-Raphson";
}

<h2 class="text-center mt-4 mb-4">@ViewBag.Title</h2>

<div class="container">
    <div class="card shadow-lg border-0 rounded-4 p-5 bg-light">

        @using (Html.BeginForm("Index", "NewtonRaphson", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
        {
            <div class="mb-4">
                <label class="form-label fw-semibold">Función f(x):</label>
                @Html.TextBoxFor(m => m.Funcion, new { @class = "form-control form-control-lg", @placeholder = "Ej: x^3 - x - 2", required = "required" })
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">Valor inicial (x₀):</label>
                    @Html.TextBoxFor(m => m.X0, new { @class = "form-control form-control-lg", type = "number", step = "any", min = "0", })
                </div>
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">Número máximo de iteraciones:</label>
                    @Html.TextBoxFor(m => m.MaxIter, new { @class = "form-control form-control-lg", type = "number", value = "100", min = "1", required = "required" })
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Tolerancia:</label>
                @Html.TextBoxFor(m => m.Tolerancia, new { @class = "form-control form-control-lg", type = "text", placeholder = "Ej: 0.000000000123456789", required = "required", inputmode = "decimal" })
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-outline-primary btn-lg" onclick="ocultarHistorial()">Calcular</button>
                <a id="btnHistorial" href="@Url.Action("Historial", "NewtonRaphson")" class="btn btn-outline-secondary btn-lg">Ver historial</a>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="alert alert-danger mt-4 text-center rounded-3">
                <strong>@Model.Mensaje</strong>
            </div>
        }

        @if (Model.Iteraciones != null && Model.Iteraciones.Any())
        {
            <h3 class="mt-5 text-center">Resultados:</h3>
            <div class="table-responsive mt-3">
                <table class="table table-striped table-hover table-bordered">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Iteración</th>
                            <th>x</th>
                            <th>f(x)</th>
                            <th>f'(x)</th>
                            <th>Siguiente x</th>
                            <th>Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Iteraciones)
                        {
                            <tr class="text-center">
                                <td>@item.Iteracion</td>
                                <td>@item.X.ToString("F6")</td>
                                <td>@item.FX.ToString("F6")</td>
                                <td>@item.DFX.ToString("F6")</td>
                                <td>@item.NextX.ToString("F6")</td>
                                <td>@item.MargenError.ToString("F6")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="alert alert-success text-center mt-4 rounded-3">
                <p><strong>Raíz aproximada:</strong> @Model.Iteraciones.Last().NextX.ToString("F6")</p>
                <p><strong>Total de iteraciones:</strong> @Model.Iteraciones.Count</p>
            </div>
        }
    </div>
</div>

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #bbdefb;
    }
    .logo-container img {
        width: 100px;
        margin-top: 10px;
    }
</style>
