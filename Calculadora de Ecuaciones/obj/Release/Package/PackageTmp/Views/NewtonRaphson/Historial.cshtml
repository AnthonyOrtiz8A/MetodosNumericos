@model List<Calculadora_de_Ecuaciones.Models.NewtonRaphsonModel>

<h2 class="text-center mt-3">Historial de Operaciones - Método de Newton-Raphson</h2>

<div class="container mt-4">
    <a href="@Url.Action("Index", "NewtonRaphson")" class="btn btn-primary mb-3">Volver al cálculo</a>

    @if (Model != null && Model.Any())
    {
        foreach (var grupo in Model)
        {
            if (grupo.UsuarioId == Convert.ToInt32(Session["UsuarioId"]))
            {
                <div class="card mb-4 shadow-sm p-3">
                    <h4>Función: <strong>@grupo.Funcion</strong></h4>
                    <p><strong>Valor inicial:</strong> X₀ = @grupo.X0</p>
                    <p><strong>Máx. Iteraciones:</strong> @grupo.MaxIter</p>
                    <p><strong>Tolerancia:</strong>@Convert.ToDouble(grupo.Tolerancia).ToString("0.############################")</p>
                    <p><strong>Fecha:</strong> @grupo.Fecha.ToString("yyyy-MM-dd HH:mm:ss")</p>

                    @if (grupo.Iteraciones != null && grupo.Iteraciones.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover mt-3">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Iteración</th>
                                        <th>X</th>
                                        <th>f(X)</th>
                                        <th>f'(X)</th>
                                        <th>Siguiente X</th>
                                        <th>Margen de Error</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var resultado in grupo.Iteraciones)
                                    {
                                        <tr>
                                            <td>@resultado.Iteracion</td>
                                            <td>@resultado.X.ToString("F6")</td>
                                            <td>@resultado.FX.ToString("F6")</td>
                                            <td>@resultado.DFX.ToString("F6")</td>
                                            <td>@resultado.NextX.ToString("F6")</td>
                                            <td>@resultado.MargenError.ToString("F6")</td> 
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center mt-3">No hay iteraciones registradas para este cálculo.</div>
                    }

                    <div class="text-center mt-3">
                        <a href="@Url.Action("GenerarPDF", "NewtonRaphson", new { grupoId = grupo.GrupoId })"
                           class="btn btn-success btn-sm">
                            Descargar PDF
                        </a>
                        <a href="@Url.Action("BorrarGrupo", "NewtonRaphson", new { grupoId = grupo.GrupoId })"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Estás seguro de que deseas eliminar este grupo?');">
                            Eliminar
                        </a>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="alert alert-info text-center">No hay cálculos guardados.</div>
    }
</div>

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #bbdefb;
    }
    .logo-container img {
        width: 100px;
        margin-top: 10px;
    }
</style>